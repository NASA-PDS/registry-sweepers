# Constants shared across all nodes — not tracked in git.
# See generate_dags.env.example for documentation.

ECS_CLUSTER_NAME=pds-nucleus-ecs
ECS_SUBNETS=[<the private subnets where the ECS task run>]
ECS_SECURITY_GROUPS=["sg-<you security group id>"]

# Venue name used in log group paths
VENUE=pds-en-dev

# Directory where DAG files are written (default: repo root)
DAGS_OUTPUT_DIR=./dags/

# (Optional) S3 bucket to push generated DAG files to after local generation.
# Each DAG is uploaded under a key: {ROOT_PREFIX}/{node_prefix}/{filename},
# e.g. dags/PDS_EN/PDS_EN-sweeper.py. Leave DAGS_S3_BUCKET unset or empty to skip S3 upload.
DAGS_S3_BUCKET=<your s3 bucket>

# Root prefix prepended to every S3 key (default: empty). Combined with the node prefix
# derived from the DAG filename (e.g. PDS_EN), giving keys like dags/PDS_EN/PDS_EN-sweeper.py.
DAGS_S3_ROOT_PREFIX=dags
